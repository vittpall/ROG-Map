<launch>
    <!-- Controlled single-wall test for occlusion-boundary detection.

         Scene: one 36x36 m ground plane, one 6 x 3 m wall at y = +5 m.
         Nothing else, so every detected boundary has an obvious cause.

         Run alongside:
           roslaunch occlusion_boundary occlusion_boundary.launch
           roslaunch rog_map_example rviz.launch
           rosrun rog_map_example keyboard_control.py

         WHAT TO CHECK IN RVIZ
           occlusion_frontier (red)  : along the wall's left, right and top
                                       edges, and lining the shadow wedge
                                       BEHIND it (y > 5).
           open_frontier      (grey) : out at the ~15 m sensing horizon.

         Red in front of the wall (y < 5), or absent from the wall edges,
         means the detector is wrong.

         Regenerate or reshape the scene with scripts/make_wall_scene.py
         (run it with the help flag to see the geometry options).
    -->

    <arg name="use_gpu_" value="true"/>
    <arg name="drone_num" value="1"/>
    <arg name="frame_id" value="world"/>
    <arg name="odom_topic" value="/lidar_slam/odom"/>

    <arg name="map_name" default="$(find occlusion_boundary)/pcd/wall_scene.pcd"/>
    <arg name="downsample_resolution" default="0.1"/>
    <arg name="lidar_type" default="mid360"/>
    <!-- true swaps perfect_drone for the real quadrotor dynamics + cascadePID,
         which also publishes /quad_0/imu. Required for FAST-LIO: perfect_drone
         assigns the commanded state directly, so its acceleration is impulsive
         and no IMU can represent it. -->
    <arg name="use_dynamics" default="false"/>

    <arg name="use_uav_extra_model" value="1"/>

    <node pkg="map_generator" name="map_pub" type="map_pub" output="screen"
          args="$(arg map_name)">
        <param name="add_boundary" value="0"/>
        <param name="is_bridge" value="0"/>
        <param name="downsample_res" value="$(arg downsample_resolution)"/>
        <param name="map_offset_x" value="0.0"/>
        <param name="map_offset_y" value="0.0"/>
        <param name="map_offset_z" value="0.0"/>
    </node>

    <group unless="$(arg use_gpu_)">
        <node pkg="map_generator" name="map_pub2" type="map_pub" output="screen"
              args="$(arg map_name)">
            <param name="downsample_res" value="$(arg downsample_resolution)"/>
            <param name="map_offset_x" value="0.0"/>
            <param name="map_offset_y" value="0.0"/>
            <param name="map_offset_z" value="0.0"/>
        </node>
    </group>

    <!-- Drone starts at the origin, 5 m in front of the wall, 1 m up. -->
    <include file="$(find test_interface)/launch/single_drone.xml">
        <arg name="drone_id" value="0"/>
        <arg name="uav_num_" value="$(arg drone_num)"/>
        <arg name="lidar_type" value="$(arg lidar_type)"/>
        <arg name="init_x_" value="0.0"/>
        <arg name="init_y_" value="0.0"/>
        <arg name="init_z_" value="1.0"/>
        <arg name="init_yaw" value="0.0"/>
        <arg name="map_name_" value="$(arg map_name)"/>
        <arg name="downsample_resolution_" value="$(arg downsample_resolution)"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="use_gpu" value="$(arg use_gpu_)"/>
        <arg name="use_uav_extra_model_" value="$(arg use_uav_extra_model)"/>
        <arg name="use_dynamics" value="$(arg use_dynamics)"/>
    </include>

</launch>
